# Copy to .env. Never commit populated secrets. Preserve existing SESSION_SECRET and DB password.
APP_ENV=development
APP_ORIGIN=http://localhost:3000
# Optional host-port overrides; keep APP_ORIGIN and S3 CORS in sync.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5433
COOKIE_SECURE=false
POSTGRES_DB=audionotes
POSTGRES_USER=audionotes
POSTGRES_PASSWORD=
# Compose builds DATABASE_URL using the three settings above and host postgres.
# Optional override (URL-encode special characters in credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/DATABASE
SESSION_SECRET=
AWS_REGION=eu-north-1
S3_BUCKET=
# Option A: standard credentials from environment (temporary session token if required).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Option B: use docker-compose.aws-profile.yml to mount your normal AWS profile read-only.
# AWS_CONFIG_DIR=C:/Users/YOUR_WINDOWS_USER/.aws
# AWS_PROFILE=default
GNANI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_BYTES=53687091200
GITHUB_REPO_URL=
