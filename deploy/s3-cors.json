{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "http://localhost:3000",
        "https://notes.example.com"
      ],
      "AllowedMethods": [
        "GET",
        "PUT",
        "HEAD"
      ],
      "AllowedHeaders": [
        "*"
      ],
      "ExposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Range",
        "Accept-Ranges"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
