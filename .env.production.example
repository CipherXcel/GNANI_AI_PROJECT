APP_ENV=production
DOMAIN=notes.example.com
APP_ORIGIN=https://notes.example.com
COOKIE_SECURE=true
POSTGRES_DB=audionotes
POSTGRES_USER=audionotes
POSTGRES_PASSWORD=
# DATABASE_URL is generated by Compose; use postgres:5432 if overriding it.
SESSION_SECRET=
AWS_REGION=eu-north-1
S3_BUCKET=
# No permanent AWS keys or AWS_PROFILE: attach an EC2 IAM role instead.
GNANI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_UPLOAD_BYTES=53687091200
GITHUB_REPO_URL=
